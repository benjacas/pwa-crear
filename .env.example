VITE_API_URL=http://localhost:8000
# Dominio público que entra en el texto del QR de cada entrada
# (${VITE_PUBLIC_URL}/entrada/<codigo>). Sin definir, se usa
# window.location.origin — sirve para desarrollo local, pero en producción
# tiene que apuntar al dominio público real (si no, el QR escaneado desde
# el celular de otra persona abriría localhost). Completar con el dominio
# real antes de desplegar.
VITE_PUBLIC_URL=https://tu-dominio-de-produccion.com
